<!-- CALLBACK MODAL -->
<div class="overlay" id="cb-modal" onclick="closeCb(event)">
  <div class="cb-modal">
    <button class="cb-close" onclick="forceCloseCb()">✕</button>
    <h3 data-i18n="cb_btn">Замовити дзвінок</h3>
    <p data-i18n="cb_p">Менеджер передзвонить вам протягом 15 хвилин.</p>
    <div id="cb-form">
      <div class="field"><label data-i18n="cb_name">Ваше ім'я</label><input type="text" id="cb-name" placeholder="Ім'я"></div>
      <div class="field"><label data-i18n="cb_phone">Телефон</label><input type="tel" id="cb-phone" placeholder="+38 (___) ___-__-__"></div>
      <div class="field" id="cb-product-wrap" style="display:none"><label data-i18n="cb_product">Товар</label><input type="text" id="cb-product" readonly></div>
      <button class="btn-submit" onclick="submitCb()" style="margin-top:6px" data-i18n="cb_btn2">Передзвоніть мені</button>
      <p class="form-note" data-i18n="cb_free">Консультація безкоштовна</p>
    </div>
    <div id="cb-success" class="success">
      <div class="si"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg></div>
      <h4 data-i18n="cb_ok_h">Дякуємо!</h4>
      <p data-i18n="cb_ok_p">Менеджер зателефонує вам найближчим часом.</p>
    </div>
  </div>
</div>

<!-- COMPARE BAR -->
<div class="cmp-bar" id="cmp-bar">
  <div class="cmp-bar-in">
    <span class="cb-lbl" data-i18n="cmp_bar">До порівняння:</span>
    <div class="cmp-thumbs" id="cmp-thumbs"></div>
    <div class="cmp-actions">
      <button class="btn-cmp-open" onclick="openCompare()" data-i18n="cmp_open">Порівняти</button>
      <button class="btn-cmp-clear" onclick="clearCompare()" data-i18n="cmp_clear">Очистити</button>
    </div>
  </div>
</div>

<!-- COMPARE MODAL -->
<div class="overlay" id="compare-modal" onclick="closeOverlay(event,'compare-modal')">
